includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - src
        - tests
    level: 8
    phpVersion: 80400
    tmpDir: .phpstan.cache
    ignoreErrors:
        - identifier: pest.expectation.redundant
        - identifier: pest.expectation.impossible
