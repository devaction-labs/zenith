{
    "name": "devaction-labs/zenith",
    "description": "The operator console and orchestration layer for Laravel Horizon, built with React and Inertia.",
    "keywords": [
        "dashboard",
        "horizon",
        "inertia",
        "laravel",
        "monitoring",
        "queues",
        "react"
    ],
    "homepage": "https://github.com/devaction-labs/zenith",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DevAction Labs",
            "email": "agencia@devaction.com.br",
            "homepage": "https://github.com/devaction-labs",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.2",
        "laravel/framework": "^13.23.0",
        "laravel/horizon": "^5.46.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.0",
        "laravel/wayfinder": "^0.1.20",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "predis/predis": "^3.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "DevactionLabs\\Zenith\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevactionLabs\\Zenith\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevactionLabs\\Zenith\\ZenithServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/devaction-labs/zenith/issues",
        "source": "https://github.com/devaction-labs/zenith"
    },
    "scripts": {
        "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "rector": "vendor/bin/rector process --dry-run --ansi",
        "rector:fix": "vendor/bin/rector process --ansi",
        "test": "vendor/bin/pest --testsuite=Package",
        "test:browser": "vendor/bin/pest --testsuite=Browser",
        "test:compatibility": "vendor/bin/pest --testsuite=Compatibility",
        "quality": [
            "@format:test",
            "@analyse",
            "@test",
            "@test:browser"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
